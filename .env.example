# 로컬 실행용 DB 주소 (docker compose 의 db 컨테이너에 접속)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/board

# docker compose 의 PostgreSQL 컨테이너 설정
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=board

# JWT 비밀키: 64자 이상 랜덤 문자열
# 생성: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 허용할 프론트엔드 주소 (콤마로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=storage
MAX_UPLOAD_SIZE_MB=5
CACHE_TTL_SECONDS=60
SQL_ECHO=false
LOGGING_MODE=info
